{
  "name": "clicktonext/merx-mollie",
  "description": "Mollie payment gateway for Kirby Merx plugin.",
  "version": "1.1.2",
  "type": "kirby-plugin",
  "license": "MIT",
  "keywords": [
    "kirby",
    "kirby-3",
    "kirby3-plugin",
    "kirby-plugin",
    "kirby-payment",
    "merx",
    "mollie",
    "payment-gateway"
  ],
  "homepage": "https://clicktonext.com",
  "support": {
    "email": "support@clicktonext.com"
  },
  "authors": [
    {
      "name": "Click to Next",
      "email": "contact@clicktonext.com",
      "homepage": "https://clicktonext.com"
    }
  ],
  "require": {
    "php": "^7.3|^8.0",
    "getkirby/composer-installer": "^1.2",
    "mollie/mollie-api-php": "^2.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "7.3"
    }
  },
  "autoload": {
    "psr-4": {
      "ClickToNext\\": "src/"
    }
  },
  "extra": {
    "installer-name": "merx-mollie"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
