{
  "name": "kirbynext/merx-mollie",
  "description": "Mollie payment gateway for Kirby 3 Merx plugin.",
  "version": "1.2.1",
  "type": "kirby-plugin",
  "license": "MIT",
  "keywords": [
    "kirbynext",
    "kirby",
    "kirby-3",
    "kirby3-plugin",
    "kirby-plugin",
    "kirbynext-plugin",
    "kirby-payment",
    "merx",
    "mollie",
    "payment-gateway"
  ],
  "homepage": "https://kirbynext.com",
  "support": {
    "email": "support@kirbynext.com"
  },
  "authors": [
    {
      "name": "Kirby Next",
      "email": "contact@kirbynext.com",
      "homepage": "https://kirbynext.com"
    }
  ],
  "require": {
    "php": "^7.4|^8.0",
    "getkirby/composer-installer": "^1.2",
    "mollie/mollie-api-php": "^2.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  },
  "autoload": {
    "psr-4": {
      "KirbyNext\\": "src/"
    }
  },
  "extra": {
    "installer-name": "kirby-merx-mollie"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
