{
  "name": "owebstudio/merx-mollie",
  "description": "Mollie payment gateway for Kirby 3 Merx plugin.",
  "version": "1.3.0",
  "type": "kirby-plugin",
  "license": "MIT",
  "keywords": [
    "owebstudio",
    "owebstudio-plugin",
    "kirby",
    "kirby-3",
    "kirby3-plugin",
    "kirby-plugin",
    "kirby-payment",
    "merx",
    "mollie",
    "payment-gateway"
  ],
  "homepage": "https://owebstudio.com",
  "support": {
    "email": "contact@owebstudio.com"
  },
  "authors": [
    {
      "name": "oweb studio",
      "email": "contact@owebstudio.com",
      "homepage": "https://owebstudio.com"
    }
  ],
  "require": {
    "php": "^8.0",
    "getkirby/composer-installer": "^1.2",
    "mollie/mollie-api-php": "^2.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  },
  "autoload": {
    "psr-4": {
      "Oweb\\": "src/"
    }
  },
  "extra": {
    "installer-name": "kirby-merx-mollie"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
